+    const int64_t ne[4] = { a->ne[2] * a->ne[1] * a->ne[0], OW, OH, b->ne[3] };
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, dst_type, 4, ne);
+    // op_params[6]: bit0 = is_2D, bit1 = channels-first source
+    int32_t params[] = { s0, s1, p0, p1, d0, d1, 1 | 2 };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_IM2COL;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_bilinear_gather(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   w,
+        int                   h) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32 || a->type == GGML_TYPE_F16);
+    GGML_ASSERT(b->type == GGML_TYPE_F32);
+    GGML_ASSERT(b->ne[0] == 2);
+    GGML_ASSERT(ggml_is_contiguous(a));
+    GGML_ASSERT(ggml_is_contiguous(b));
+    GGML_ASSERT(a->ne[1] == (int64_t) w * h);
+
+    struct ggml_tensor * result = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, a->ne[0], b->ne[1]);
+    int32_t params[] = { w, h };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_BILINEAR_GATHER;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}

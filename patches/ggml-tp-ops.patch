diff --git a/src/ggml-cuda/tp-fused.cu b/src/ggml-cuda/tp-fused.cu
new file mode 100644
index 00000000..c4de6af5
--- /dev/null
+++ b/src/ggml-cuda/tp-fused.cu
@@ -0,0 +1,191 @@
+// fused pointwise ops for the talking-portrait decoder:
+//   bias_lrelu:   y = leaky_relu(x + bias[c], slope)
+//   subpix_lrelu: 2x2 sub-pixel interleave of two parity-group maps + bias
+//                 + leaky_relu (see ggml.h)
+#include "tp-fused.cuh"
+
+static __global__ void bias_lrelu_kernel(
+        const float * __restrict__ x, const float * __restrict__ b,
+        float * __restrict__ y, const int64_t n, const int C,
+        const int64_t d01, const int axis, const float slope) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const int c = axis == 0 ? (int)(i % C) : (int)((i / d01) % C);
+    const float v = x[i] + b[c];
+    y[i] = v > 0.0f ? v : slope * v;
+}
+
+static __global__ void subpix_lrelu_kernel(
+        const float * __restrict__ g0, const float * __restrict__ g1,
+        const float * __restrict__ b, float * __restrict__ y,
+        const int64_t n, const int W, const int H, const int OC,
+        const float slope) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n) return;
+    const int xx = (int)(i % (2 * W));
+    const int yy = (int)((i / (2 * W)) % (2 * H));
+    const int o  = (int)(i / ((int64_t) 4 * W * H));
+    const float * g = (yy & 1) ? g1 : g0;
+    const float v = g[(xx >> 1) + (int64_t) W * ((yy >> 1) + (int64_t) H * (o + OC * (xx & 1)))] + b[o];
+    y[i] = v > 0.0f ? v : slope * v;
+}
+
+void ggml_cuda_op_bias_lrelu(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    const int axis = ((const int32_t *) dst->op_params)[0];
+    float slope;
+    memcpy(&slope, (const int32_t *) dst->op_params + 1, sizeof(float));
+    const int64_t n = ggml_nelements(src0);
+    const int C = (int) ggml_nelements(src1);
+    const int64_t d01 = src0->ne[0] * src0->ne[1];
+    const int block = 256;
+    const int64_t grid = (n + block - 1) / block;
+    bias_lrelu_kernel<<<grid, block, 0, ctx.stream()>>>(
+        (const float *) src0->data, (const float *) src1->data,
+        (float *) dst->data, n, C, d01, axis, slope);
+}
+
+void ggml_cuda_op_subpix_lrelu(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * g0 = dst->src[0];
+    const ggml_tensor * g1 = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+    float slope;
+    memcpy(&slope, dst->op_params, sizeof(float));
+    const int W = (int) g0->ne[0];
+    const int H = (int) g0->ne[1];
+    const int OC = (int) (g0->ne[2] / 2);
+    const int64_t n = ggml_nelements(dst);
+    const int block = 256;
+    const int64_t grid = (n + block - 1) / block;
+    subpix_lrelu_kernel<<<grid, block, 0, ctx.stream()>>>(
+        (const float *) g0->data, (const float *) g1->data,
+        (const float *) bias->data, (float *) dst->data, n, W, H, OC, slope);
+}
+
+
+static __global__ void subpix_lrelu_cl_kernel(
+        const float * __restrict__ y4, const float * __restrict__ b,
+        float * __restrict__ y, const int64_t n_tot, const int OC,
+        const int64_t N, const int W, const float slope) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_tot) return;
+    const int     o  = (int)(i % OC);
+    const int64_t t  = i / OC;
+    const int64_t nn = t % (4 * N);
+    const int64_t bb = t / (4 * N);
+    const int X = (int)(nn % (2 * W)), Y = (int)(nn / (2 * W));
+    const int k = (Y & 1) * 2 + (X & 1);
+    const float v = y4[(o + (int64_t) OC * k) + (int64_t) 4 * OC * ((X >> 1) + (int64_t) W * (Y >> 1) + N * bb)] + b[o];
+    y[i] = v > 0.0f ? v : slope * v;
+}
+
+static __global__ void upfirdn2x_kernel(
+        const float * __restrict__ x, const float * __restrict__ k4,
+        float * __restrict__ y, const int64_t n_tot, const int W, const int H) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_tot) return;
+    const int X = (int)(i % (2 * W));
+    const int Y = (int)((i / (2 * W)) % (2 * H));
+    const int64_t cb = i / ((int64_t) 4 * W * H);
+    const float * xp = x + (int64_t) W * H * cb;
+    float acc = 0.0f;
+#pragma unroll
+    for (int j = 0; j < 4; j++) {
+        const int vy = Y + j - 2;
+        if (vy < 0 || vy >= 2 * H || (vy & 1)) continue;
+#pragma unroll
+        for (int ii = 0; ii < 4; ii++) {
+            const int vx = X + ii - 2;
+            if (vx < 0 || vx >= 2 * W || (vx & 1)) continue;
+            acc += xp[(vx >> 1) + (int64_t) W * (vy >> 1)] * k4[ii + 4 * j];
+        }
+    }
+    y[i] = acc;
+}
+
+void ggml_cuda_op_subpix_lrelu_cl(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * y4 = dst->src[0];
+    const ggml_tensor * bias = dst->src[1];
+    const int W = ((const int32_t *) dst->op_params)[0];
+    float slope;
+    memcpy(&slope, (const int32_t *) dst->op_params + 1, sizeof(float));
+    const int OC = (int)(y4->ne[0] / 4);
+    const int64_t N = y4->ne[1];
+    const int64_t n = ggml_nelements(dst);
+    const int block = 256;
+    subpix_lrelu_cl_kernel<<<(n + block - 1) / block, block, 0, ctx.stream()>>>(
+        (const float *) y4->data, (const float *) bias->data, (float *) dst->data,
+        n, OC, N, W, slope);
+}
+
+void ggml_cuda_op_upfirdn2x(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src = dst->src[0];
+    const ggml_tensor * kern = dst->src[1];
+    const int W = (int) src->ne[0];
+    const int H = (int) src->ne[1];
+    const int64_t n = ggml_nelements(dst);
+    const int block = 256;
+    upfirdn2x_kernel<<<(n + block - 1) / block, block, 0, ctx.stream()>>>(
+        (const float *) src->data, (const float *) kern->data, (float *) dst->data,
+        n, W, H);
+}
+
+
+template <bool LERP>
+static __global__ void clsp_kernel(
+        const float * __restrict__ a, const float * __restrict__ m,
+        const float * __restrict__ o, float * __restrict__ y,
+        const int64_t n_tot, const int C, const int64_t N) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= n_tot) return;
+    const int64_t n = i % N;
+    const int     c = (int)(i / N);
+    const float w = m[n];
+    float v = a[c + (int64_t) C * n] * w;
+    if (LERP) v += o[i] * (1.0f - w);
+    y[i] = v;
+}
+
+void ggml_cuda_op_clsp(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * cl = dst->src[0];
+    const int C = (int) cl->ne[0];
+    const int64_t N = cl->ne[1];
+    const int64_t n = (int64_t) C * N;
+    const int block = 256;
+    const int64_t grid = (n + block - 1) / block;
+    if (dst->op == GGML_OP_CLSP_LERP) {
+        clsp_kernel<true><<<grid, block, 0, ctx.stream()>>>(
+            (const float *) cl->data, (const float *) dst->src[1]->data,
+            (const float *) dst->src[2]->data, (float *) dst->data, n, C, N);
+    } else {
+        clsp_kernel<false><<<grid, block, 0, ctx.stream()>>>(
+            (const float *) cl->data, (const float *) dst->src[1]->data,
+            nullptr, (float *) dst->data, n, C, N);
+    }
+}
+
+
+static __global__ void flow_grid_kernel(
+        const float * __restrict__ f, const float * __restrict__ x,
+        float * __restrict__ y, const int64_t N) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= 3 * N) return;
+    const int64_t pln = i / N, n = i % N;
+    float v;
+    if (pln == 2) {
+        v = 1.0f / (1.0f + expf(-f[2 * N + n]));
+    } else {
+        v = tanhf(f[pln * N + n]) + x[pln * N + n];
+    }
+    y[i] = v;
+}
+
+void ggml_cuda_op_flow_grid(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * fl = dst->src[0];
+    const int64_t N = fl->ne[0] * fl->ne[1];
+    const int block = 256;
+    flow_grid_kernel<<<(3 * N + block - 1) / block, block, 0, ctx.stream()>>>(
+        (const float *) fl->data, (const float *) dst->src[1]->data,
+        (float *) dst->data, N);
+}

+struct ggml_tensor * ggml_im2col_cf(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * a,
+        struct ggml_tensor  * b,
+        int                   s0,
+        int                   s1,
+        int                   p0,
+        int                   p1,
+        int                   d0,
+        int                   d1,
+        enum ggml_type        dst_type) {
+    GGML_ASSERT(a->ne[2] == b->ne[0]);  // IC
+    GGML_ASSERT(ggml_is_contiguous(b));
+
+    const int64_t OH = ggml_calc_conv_output_size(b->ne[2], a->ne[1], s1, p1, d1);
+    const int64_t OW = ggml_calc_conv_output_size(b->ne[1], a->ne[0], s0, p0, d0);
+
+    GGML_ASSERT((OH > 0) && "b too small compared to a");
+    GGML_ASSERT((OW > 0) && "b too small compared to a");
+
+    const int64_t ne[4] = { a->ne[2] * a->ne[1] * a->ne[0], OW, OH, b->ne[3] };
+
+    struct ggml_tensor * result = ggml_new_tensor(ctx, dst_type, 4, ne);
+    // op_params[6]: bit0 = is_2D, bit1 = channels-first source
+    int32_t params[] = { s0, s1, p0, p1, d0, d1, 1 | 2 };
+    ggml_set_op_params(result, params, sizeof(params));
+
+    result->op     = GGML_OP_IM2COL;
+    result->src[0] = a;
+    result->src[1] = b;
+
+    return result;
+}

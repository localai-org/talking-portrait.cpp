diff --git a/src/ggml-vulkan/vulkan-shaders/bias_lrelu.comp b/src/ggml-vulkan/vulkan-shaders/bias_lrelu.comp
new file mode 100644
index 00000000..07179cce
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/bias_lrelu.comp
@@ -0,0 +1,34 @@
+#version 450
+// fused y = leaky_relu(x + bias[c], slope); bias broadcast on axis 0
+// (c = i % C, channel-fastest layouts) or axis 2 (c = (i / d01) % C,
+// spatial [W,H,C] maps).
+//   binding 0: x    f32
+//   binding 1: bias f32 (C values)
+//   binding 2: y    f32
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint n;
+    uint C;
+    uint d01;
+    uint axis;
+    float slope;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const uint c = p.axis == 0 ? i % p.C : (i / p.d01) % p.C;
+    const float v = float(data_a[i]) + float(data_b[c]);
+    data_d[i] = D_TYPE(v > 0.0f ? v : p.slope * v);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp b/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp
new file mode 100644
index 00000000..ae145e24
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp
@@ -0,0 +1,57 @@
+#version 450
+// fused bilinear sampling gather (torch grid_sample: bilinear, zeros
+// padding, align_corners=false) over a channels-first flattened map.
+//   binding 0: feat [C, W*H] (A_TYPE f32/f16)
+//   binding 1: grid [2, N] f32 normalized (x, y)
+//   binding 2: dst  [C, N] f32
+
+#include "types.glsl"
+
+#extension GL_EXT_control_flow_attributes : enable
+
+layout (push_constant) uniform parameter
+{
+    uint C;
+    uint N;
+    uint W;
+    uint H;
+    uint sp;  // dst layout: 0 = [C, N], 1 = [N, C]
+    uint pl;  // grid layout: 0 = [2, N] interleaved, 1 = [N, 2] planar
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.C * p.N) {
+        return;
+    }
+    const uint c = p.sp != 0 ? i / p.N : i % p.C;
+    const uint n = p.sp != 0 ? i % p.N : i / p.C;
+
+    const float gx = float(p.pl != 0 ? data_b[n]       : data_b[2*n + 0]);
+    const float gy = float(p.pl != 0 ? data_b[p.N + n] : data_b[2*n + 1]);
+    const float fx = (gx + 1.0f) * 0.5f * float(p.W) - 0.5f;
+    const float fy = (gy + 1.0f) * 0.5f * float(p.H) - 0.5f;
+    const int x0 = int(floor(fx));
+    const int y0 = int(floor(fy));
+    const float wx = fx - float(x0);
+    const float wy = fy - float(y0);
+
+    float acc = 0.0f;
+    [[unroll]] for (int k = 0; k < 4; k++) {
+        const int cx = x0 + (k & 1);
+        const int cy = y0 + (k >> 1);
+        if (cx < 0 || cx >= int(p.W) || cy < 0 || cy >= int(p.H)) {
+            continue;
+        }
+        const float wgt = (((k & 1) != 0) ? wx : (1.0f - wx)) *
+                          (((k >> 1) != 0) ? wy : (1.0f - wy));
+        acc += wgt * float(data_a[(uint(cy) * p.W + uint(cx)) * p.C + c]);
+    }
+    data_d[i] = D_TYPE(acc);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/clsp.comp b/src/ggml-vulkan/vulkan-shaders/clsp.comp
new file mode 100644
index 00000000..6d1d4cad
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/clsp.comp
@@ -0,0 +1,44 @@
+#version 450
+// fused channel-last -> spatial transpose with the warp mask:
+//   dst[n + N*c] = cl[c + C*n] * m[n]              (clsp_mul)
+//   dst[n + N*c] = cl[c + C*n]*m[n]
+//                  + out_sp[n + N*c]*(1 - m[n])    (clsp_lerp, LERP defined)
+//   binding 0: cl f32 [C, N]
+//   binding 1: m  f32 [N]
+//   binding 2 (lerp only): out_sp f32 [N, C]
+//   last binding: dst f32 [N, C]
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint n;
+    uint C;
+    uint N;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+#ifdef LERP
+layout (binding = 2) readonly buffer C_ {A_TYPE data_c[];};
+layout (binding = 3) writeonly buffer D {D_TYPE data_d[];};
+#else
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+#endif
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const uint nn = i % p.N;
+    const uint c  = i / p.N;
+    const float w = float(data_b[nn]);
+    float v = float(data_a[c + p.C * nn]) * w;
+#ifdef LERP
+    v += float(data_c[i]) * (1.0f - w);
+#endif
+    data_d[i] = D_TYPE(v);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/flow_grid.comp b/src/ggml-vulkan/vulkan-shaders/flow_grid.comp
new file mode 100644
index 00000000..28c9b7c7
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/flow_grid.comp
@@ -0,0 +1,35 @@
+#version 450
+// fused flow-map head: fl [W, H, 3] (channels gx, gy, m), xs [W, H, 2]
+// identity grids -> dst [N, 3] planar (see ggml.h):
+//   binding 0: fl f32
+//   binding 1: xs f32
+//   binding 2: dst f32 [N, 3]
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint N;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= 3u * p.N) {
+        return;
+    }
+    const uint pln = i / p.N;
+    const uint n = i % p.N;
+    float v;
+    if (pln == 2u) {
+        v = 1.0f / (1.0f + exp(-float(data_a[2u * p.N + n])));
+    } else {
+        v = tanh(float(data_a[pln * p.N + n])) + float(data_b[pln * p.N + n]);
+    }
+    data_d[i] = D_TYPE(v);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp b/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp
new file mode 100644
index 00000000..c39591a0
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp
@@ -0,0 +1,55 @@
+#version 450
+// channels-first im2col: src [IC, IW, IH, N] contiguous, dst rows are
+// ic-fastest: r = ic + IC*(kw + KW*kh). One workgroup slice per output
+// pixel (y = ow, z = oh + OH*batch), x-threads loop over R = IC*KW*KH.
+//   binding 0: src  [IC, IW, IH, N] f32 (the op's src1)
+//   binding 1: dst  [R, OW, OH, N]  (D_TYPE f32/f16)
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint IC;
+    uint IW;
+    uint IH;
+    uint OW;
+    uint OH;
+    uint KW;
+    uint R;   // IC*KW*KH
+    int  s0;
+    int  s1;
+    int  p0;
+    int  p1;
+    int  d0;
+    int  d1;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint ow = gl_GlobalInvocationID.y;
+    const uint z  = gl_GlobalInvocationID.z;  // oh + OH*batch
+    const uint oh = z % p.OH;
+    if (ow >= p.OW) {
+        return;
+    }
+    const uint src_off = (z / p.OH) * p.IC * p.IW * p.IH;
+    const uint base = (z * p.OW + ow) * p.R;
+    const uint stride = gl_WorkGroupSize.x * gl_NumWorkGroups.x;
+    for (uint r = gl_GlobalInvocationID.x; r < p.R; r += stride) {
+        const uint ic = r % p.IC;
+        const uint k  = r / p.IC;
+        const uint kw = k % p.KW;
+        const uint kh = k / p.KW;
+        const int iw = int(ow) * p.s0 + int(kw) * p.d0 - p.p0;
+        const int ih = int(oh) * p.s1 + int(kh) * p.d1 - p.p1;
+        float v = 0.0f;
+        if (iw >= 0 && iw < int(p.IW) && ih >= 0 && ih < int(p.IH)) {
+            v = float(data_a[src_off + (uint(ih) * p.IW + uint(iw)) * p.IC + ic]);
+        }
+        data_d[base + r] = D_TYPE(v);
+    }
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/subpix_lrelu.comp b/src/ggml-vulkan/vulkan-shaders/subpix_lrelu.comp
new file mode 100644
index 00000000..66228369
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/subpix_lrelu.comp
@@ -0,0 +1,39 @@
+#version 450
+// fused 2x2 sub-pixel interleave + bias + leaky_relu over two parity group
+// maps g0 (by=0) / g1 (by=1), each [W, H, 2*OC] with channel q = bx*OC + o:
+//   dst[2n+bx, 2m+by, o] = lrelu(g{by}[n, m, o + OC*bx] + bias[o])
+//   binding 0: g0   f32
+//   binding 1: g1   f32
+//   binding 2: bias f32 (OC values)
+//   binding 3: dst  f32 [2W, 2H, OC]
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint n;
+    uint W;
+    uint H;
+    uint OC;
+    float slope;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) readonly buffer C {FLOAT_TYPE data_c[];};
+layout (binding = 3) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const uint xx = i % (2u * p.W);
+    const uint yy = (i / (2u * p.W)) % (2u * p.H);
+    const uint o  = i / (4u * p.W * p.H);
+    const uint s  = (xx >> 1) + p.W * ((yy >> 1) + p.H * (o + p.OC * (xx & 1u)));
+    const float v = ((yy & 1u) == 1u ? float(data_b[s]) : float(data_a[s])) + float(data_c[o]);
+    data_d[i] = D_TYPE(v > 0.0f ? v : p.slope * v);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/subpix_lrelu_cl.comp b/src/ggml-vulkan/vulkan-shaders/subpix_lrelu_cl.comp
new file mode 100644
index 00000000..26119c84
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/subpix_lrelu_cl.comp
@@ -0,0 +1,40 @@
+#version 450
+// channel-last 2x2 sub-pixel interleave + bias + leaky_relu:
+// y4 [4*OC, N=W*H, B] column q = (by*2+bx)*OC + o -> dst [OC, 4N, B]:
+//   dst[o, (2n+bx) + 2W*(2m+by), b] = lrelu(y4[o + OC*k, n + W*m, b] + bias[o])
+//   binding 0: y4   f32
+//   binding 1: bias f32 (OC values)
+//   binding 2: dst  f32
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint n;   // total dst elements
+    uint OC;
+    uint N;   // W*H
+    uint W;
+    float slope;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const uint o  = i % p.OC;
+    const uint t  = i / p.OC;
+    const uint nn = t % (4u * p.N);
+    const uint bb = t / (4u * p.N);
+    const uint X = nn % (2u * p.W);
+    const uint Y = nn / (2u * p.W);
+    const uint k = (Y & 1u) * 2u + (X & 1u);
+    const float v = float(data_a[(o + p.OC * k) + 4u * p.OC * ((X >> 1) + p.W * (Y >> 1) + p.N * bb)]) + float(data_b[o]);
+    data_d[i] = D_TYPE(v > 0.0f ? v : p.slope * v);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/upfirdn2x.comp b/src/ggml-vulkan/vulkan-shaders/upfirdn2x.comp
new file mode 100644
index 00000000..eac00aad
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/upfirdn2x.comp
@@ -0,0 +1,49 @@
+#version 450
+// fused upfirdn2d(up=2, pad=(2,1)) with a 4x4 FIR kernel:
+// src [W, H, C, B] -> dst [2W, 2H, C, B]
+//   binding 0: src  f32
+//   binding 1: kern f32 (16 values, [4,4])
+//   binding 2: dst  f32
+
+#include "types.glsl"
+
+#extension GL_EXT_control_flow_attributes : enable
+
+layout (push_constant) uniform parameter
+{
+    uint n;  // total dst elements
+    uint W;
+    uint H;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.n) {
+        return;
+    }
+    const uint X  = i % (2u * p.W);
+    const uint Y  = (i / (2u * p.W)) % (2u * p.H);
+    const uint cb = i / (4u * p.W * p.H);
+    const uint base = p.W * p.H * cb;
+    float acc = 0.0f;
+    [[unroll]] for (int j = 0; j < 4; j++) {
+        const int vy = int(Y) + j - 2;
+        if (vy < 0 || vy >= int(2u * p.H) || (vy & 1) != 0) {
+            continue;
+        }
+        [[unroll]] for (int ii = 0; ii < 4; ii++) {
+            const int vx = int(X) + ii - 2;
+            if (vx < 0 || vx >= int(2u * p.W) || (vx & 1) != 0) {
+                continue;
+            }
+            acc += float(data_a[base + uint(vx >> 1) + p.W * uint(vy >> 1)]) * float(data_b[ii + 4 * j]);
+        }
+    }
+    data_d[i] = D_TYPE(acc);
+}

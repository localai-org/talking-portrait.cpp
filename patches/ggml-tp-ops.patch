diff --git a/src/ggml-cuda/bilinear-gather.cu b/src/ggml-cuda/bilinear-gather.cu
new file mode 100644
index 00000000..fa7be408
--- /dev/null
+++ b/src/ggml-cuda/bilinear-gather.cu
@@ -0,0 +1,61 @@
+// fused bilinear sampling gather (torch grid_sample: bilinear, zeros
+// padding, align_corners=false) over a channels-first flattened map.
+//   src0: feat [C, W*H] (F32/F16)  src1: grid [2, N] F32  dst: [C, N] F32
+#include "bilinear-gather.cuh"
+
+template <typename T>
+static __global__ void bilinear_gather_kernel(
+        const T * __restrict__ feat, const float * __restrict__ grid,
+        float * __restrict__ dst, const int C, const int W, const int H,
+        const int64_t total) {
+    const int64_t i = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= total) return;
+    const int     c = (int) (i % C);
+    const int64_t n = i / C;
+
+    const float gx = grid[2*n + 0];
+    const float gy = grid[2*n + 1];
+    const float fx = (gx + 1.0f) * 0.5f * (float) W - 0.5f;
+    const float fy = (gy + 1.0f) * 0.5f * (float) H - 0.5f;
+    const int x0 = (int) floorf(fx);
+    const int y0 = (int) floorf(fy);
+    const float wx = fx - (float) x0;
+    const float wy = fy - (float) y0;
+
+    float acc = 0.0f;
+#pragma unroll
+    for (int k = 0; k < 4; k++) {
+        const int cx = x0 + (k & 1);
+        const int cy = y0 + (k >> 1);
+        if (cx < 0 || cx >= W || cy < 0 || cy >= H) continue;
+        const float wgt = ((k & 1) ? wx : 1.0f - wx) * ((k >> 1) ? wy : 1.0f - wy);
+        acc += wgt * (float) feat[(int64_t) (cy * W + cx) * C + c];
+    }
+    dst[i] = acc;
+}
+
+void ggml_cuda_op_bilinear_gather(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+    GGML_ASSERT(src1->type == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type == GGML_TYPE_F32);
+
+    const int W = ((const int32_t *) dst->op_params)[0];
+    const int H = ((const int32_t *) dst->op_params)[1];
+    const int C = (int) src0->ne[0];
+    const int64_t N = src1->ne[1];
+    const int64_t total = (int64_t) C * N;
+
+    cudaStream_t stream = ctx.stream();
+    const int block = 256;
+    const int64_t grid_sz = (total + block - 1) / block;
+    if (src0->type == GGML_TYPE_F16) {
+        bilinear_gather_kernel<half><<<grid_sz, block, 0, stream>>>(
+            (const half *) src0->data, (const float *) src1->data,
+            (float *) dst->data, C, W, H, total);
+    } else {
+        bilinear_gather_kernel<float><<<grid_sz, block, 0, stream>>>(
+            (const float *) src0->data, (const float *) src1->data,
+            (float *) dst->data, C, W, H, total);
+    }
+}

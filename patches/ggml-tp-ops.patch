+// ggml_compute_forward_bilinear_gather
+// torch grid_sample (bilinear, zeros padding, align_corners=false) over a
+// channels-first flattened map: src0 [C, W*H] (F32/F16), src1 [2, N] grid,
+// dst [C, N] F32.
+
+void ggml_compute_forward_bilinear_gather(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    const int32_t W = ((const int32_t *)(dst->op_params))[0];
+    const int32_t H = ((const int32_t *)(dst->op_params))[1];
+    const int32_t sp = ((const int32_t *)(dst->op_params))[2];  // dst [N, C]
+    const int32_t pl = ((const int32_t *)(dst->op_params))[3];  // grid [N, 2] planar
+
+    const int64_t C = src0->ne[0];
+    const int64_t N = pl ? src1->ne[0] : src1->ne[1];
+
+    const float * grid = (const float *) src1->data;
+    float * out = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    for (int64_t n = ith; n < N; n += nth) {
+        const float gx = pl ? grid[n]     : grid[2*n + 0];
+        const float gy = pl ? grid[N + n] : grid[2*n + 1];
+        const float fx = (gx + 1.0f) * 0.5f * (float) W - 0.5f;
+        const float fy = (gy + 1.0f) * 0.5f * (float) H - 0.5f;
+        const int64_t x0 = (int64_t) floorf(fx);
+        const int64_t y0 = (int64_t) floorf(fy);
+        const float wx = fx - (float) x0;
+        const float wy = fy - (float) y0;
+
+        float * d = out + (sp ? n : C*n);
+        const int64_t ds = sp ? N : 1;  // per-channel stride in dst
+        for (int64_t c = 0; c < C; c++) d[c*ds] = 0.0f;
+
+        for (int k = 0; k < 4; k++) {
+            const int64_t cx = x0 + (k & 1);
+            const int64_t cy = y0 + (k >> 1);
+            if (cx < 0 || cx >= W || cy < 0 || cy >= H) continue;
+            const float wgt = ((k & 1) ? wx : 1.0f - wx) * ((k >> 1) ? wy : 1.0f - wy);
+            const int64_t row = cy * W + cx;
+            if (src0->type == GGML_TYPE_F16) {
+                const ggml_fp16_t * f = (const ggml_fp16_t *) src0->data + C*row;
+                for (int64_t c = 0; c < C; c++) d[c*ds] += wgt * GGML_CPU_FP16_TO_FP32(f[c]);
+            } else {
+                const float * f = (const float *) src0->data + C*row;
+                for (int64_t c = 0; c < C; c++) d[c*ds] += wgt * f[c];
+            }
+        }
+    }
+}
+
+
+// ggml_compute_forward_bias_lrelu
+// y = leaky_relu(x + bias): src0 x (F32 contiguous), src1 bias (C floats),
+// broadcast on op_params[0] axis (0 or 2); slope in op_params[1].
+
+void ggml_compute_forward_bias_lrelu(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    const int32_t axis = ((const int32_t *)(dst->op_params))[0];
+    float slope;
+    memcpy(&slope, (const int32_t *)(dst->op_params) + 1, sizeof(float));
+
+    const int64_t C  = ggml_nelements(src1);
+    const int64_t n  = ggml_nelements(src0);
+    const int64_t d01 = src0->ne[0] * src0->ne[1];
+
+    const float * x = (const float *) src0->data;
+    const float * b = (const float *) src1->data;
+    float * y = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int64_t per = (n + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n ? i0 + per : n;
+
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t c = axis == 0 ? i % C : (i / d01) % C;
+        const float v = x[i] + b[c];
+        y[i] = v > 0.0f ? v : slope * v;
+    }
+}
+
+// ggml_compute_forward_subpix_lrelu
+// dst[2n+bx, 2m+by, o] = lrelu(g{by}[n, m, o + OC*bx] + bias[o])
+
+void ggml_compute_forward_subpix_lrelu(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * g0 = dst->src[0];
+    const ggml_tensor * g1 = dst->src[1];
+    const ggml_tensor * bias = dst->src[2];
+
+    float slope;
+    memcpy(&slope, dst->op_params, sizeof(float));
+
+    const int64_t W  = g0->ne[0];
+    const int64_t H  = g0->ne[1];
+    const int64_t OC = g0->ne[2] / 2;
+    const int64_t n  = ggml_nelements(dst);
+
+    const float * b = (const float *) bias->data;
+    float * y = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int64_t per = (n + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n ? i0 + per : n;
+
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t xx = i % (2 * W);
+        const int64_t yy = (i / (2 * W)) % (2 * H);
+        const int64_t o  = i / (4 * W * H);
+        const float * g = (const float *) ((yy & 1) ? g1->data : g0->data);
+        const float v = g[(xx >> 1) + W * ((yy >> 1) + H * (o + OC * (xx & 1)))] + b[o];
+        y[i] = v > 0.0f ? v : slope * v;
+    }
+}
+
+
+// ggml_compute_forward_subpix_lrelu_cl
+// dst[o, (2n+bx) + 2W*(2m+by), b] = lrelu(y4[o + OC*(by*2+bx), n + W*m, b] + bias[o])
+
+void ggml_compute_forward_subpix_lrelu_cl(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * y4 = dst->src[0];
+    const ggml_tensor * bias = dst->src[1];
+
+    const int32_t Wd = ((const int32_t *)(dst->op_params))[0];
+    float slope;
+    memcpy(&slope, (const int32_t *)(dst->op_params) + 1, sizeof(float));
+
+    const int64_t OC = y4->ne[0] / 4;
+    const int64_t N  = y4->ne[1];        // W*H
+    const int64_t n_tot = ggml_nelements(dst);
+    const int64_t W2 = 2 * Wd;
+
+    const float * b = (const float *) bias->data;
+    const float * s0 = (const float *) y4->data;
+    float * y = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int64_t per = (n_tot + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n_tot ? i0 + per : n_tot;
+
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t o  = i % OC;
+        const int64_t t  = i / OC;
+        const int64_t nn = t % (4 * N);
+        const int64_t bb = t / (4 * N);
+        const int64_t X = nn % W2, Y = nn / W2;
+        const int64_t k = (Y & 1) * 2 + (X & 1);
+        const float v = s0[(o + OC * k) + 4 * OC * ((X >> 1) + Wd * (Y >> 1) + N * bb)] + b[o];
+        y[i] = v > 0.0f ? v : slope * v;
+    }
+}
+
+// ggml_compute_forward_upfirdn2x
+// upfirdn2d(up=2, pad=(2,1)) with a 4x4 kernel: [W,H,C,B] -> [2W,2H,C,B]
+
+void ggml_compute_forward_upfirdn2x(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src = dst->src[0];
+    const ggml_tensor * kern = dst->src[1];
+
+    const int64_t W = src->ne[0];
+    const int64_t H = src->ne[1];
+    const int64_t n_tot = ggml_nelements(dst);
+
+    const float * x = (const float *) src->data;
+    const float * k4 = (const float *) kern->data;
+    float * y = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+    const int64_t per = (n_tot + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n_tot ? i0 + per : n_tot;
+
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t X = i % (2 * W);
+        const int64_t Y = (i / (2 * W)) % (2 * H);
+        const int64_t cb = i / (4 * W * H);   // c + C*b combined plane index
+        const float * xp = x + W * H * cb;
+        float acc = 0.0f;
+        for (int j = 0; j < 4; j++) {
+            const int64_t vy = Y + j - 2;
+            if (vy < 0 || vy >= 2 * H || (vy & 1)) continue;
+            for (int ii = 0; ii < 4; ii++) {
+                const int64_t vx = X + ii - 2;
+                if (vx < 0 || vx >= 2 * W || (vx & 1)) continue;
+                acc += xp[(vx >> 1) + W * (vy >> 1)] * k4[ii + 4 * j];
+            }
+        }
+        y[i] = acc;
+    }
+}
+
+
+// ggml_compute_forward_clsp_mul / _lerp
+// channel-last -> spatial transpose fused with the warp mask (see ggml.h)
+
+void ggml_compute_forward_clsp_mul(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * cl = dst->src[0];
+    const int64_t C = cl->ne[0], N = cl->ne[1];
+    const float * a = (const float *) cl->data;
+    const float * m = (const float *) dst->src[1]->data;
+    float * y = (float *) dst->data;
+
+    const int64_t n_tot = C * N;
+    const int ith = params->ith, nth = params->nth;
+    const int64_t per = (n_tot + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n_tot ? i0 + per : n_tot;
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t n = i % N, c = i / N;
+        y[i] = a[c + C * n] * m[n];
+    }
+}
+
+void ggml_compute_forward_clsp_lerp(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * cl = dst->src[0];
+    const int64_t C = cl->ne[0], N = cl->ne[1];
+    const float * a = (const float *) cl->data;
+    const float * m = (const float *) dst->src[1]->data;
+    const float * o = (const float *) dst->src[2]->data;
+    float * y = (float *) dst->data;
+
+    const int64_t n_tot = C * N;
+    const int ith = params->ith, nth = params->nth;
+    const int64_t per = (n_tot + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n_tot ? i0 + per : n_tot;
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t n = i % N, c = i / N;
+        y[i] = a[c + C * n] * m[n] + o[i] * (1.0f - m[n]);
+    }
+}
+
+
+// ggml_compute_forward_flow_grid
+// fl [W,H,3,1] -> dst [N,3] planar: (tanh(ch0)+xsx, tanh(ch1)+xsy, sigmoid(ch2))
+
+void ggml_compute_forward_flow_grid(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * fl = dst->src[0];
+    const ggml_tensor * xs = dst->src[1];
+    const int64_t N = fl->ne[0] * fl->ne[1];
+    const float * f = (const float *) fl->data;
+    const float * x = (const float *) xs->data;
+    float * y = (float *) dst->data;
+
+    const int ith = params->ith, nth = params->nth;
+    const int64_t n_tot = 3 * N;
+    const int64_t per = (n_tot + nth - 1) / nth;
+    const int64_t i0 = ith * per, i1 = i0 + per < n_tot ? i0 + per : n_tot;
+    for (int64_t i = i0; i < i1; i++) {
+        const int64_t pln = i / N, n = i % N;
+        float v;
+        if (pln == 2) {
+            v = 1.0f / (1.0f + expf(-f[2 * N + n]));
+        } else {
+            v = tanhf(f[pln * N + n]) + x[pln * N + n];
+        }
+        y[i] = v;
+    }
+}

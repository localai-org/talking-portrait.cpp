diff --git a/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp b/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp
new file mode 100644
index 00000000..8a788fab
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/bilinear_gather.comp
@@ -0,0 +1,55 @@
+#version 450
+// fused bilinear sampling gather (torch grid_sample: bilinear, zeros
+// padding, align_corners=false) over a channels-first flattened map.
+//   binding 0: feat [C, W*H] (A_TYPE f32/f16)
+//   binding 1: grid [2, N] f32 normalized (x, y)
+//   binding 2: dst  [C, N] f32
+
+#include "types.glsl"
+
+#extension GL_EXT_control_flow_attributes : enable
+
+layout (push_constant) uniform parameter
+{
+    uint C;
+    uint N;
+    uint W;
+    uint H;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
+layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint i = gl_GlobalInvocationID.x;
+    if (i >= p.C * p.N) {
+        return;
+    }
+    const uint c = i % p.C;
+    const uint n = i / p.C;
+
+    const float gx = float(data_b[2*n + 0]);
+    const float gy = float(data_b[2*n + 1]);
+    const float fx = (gx + 1.0f) * 0.5f * float(p.W) - 0.5f;
+    const float fy = (gy + 1.0f) * 0.5f * float(p.H) - 0.5f;
+    const int x0 = int(floor(fx));
+    const int y0 = int(floor(fy));
+    const float wx = fx - float(x0);
+    const float wy = fy - float(y0);
+
+    float acc = 0.0f;
+    [[unroll]] for (int k = 0; k < 4; k++) {
+        const int cx = x0 + (k & 1);
+        const int cy = y0 + (k >> 1);
+        if (cx < 0 || cx >= int(p.W) || cy < 0 || cy >= int(p.H)) {
+            continue;
+        }
+        const float wgt = (((k & 1) != 0) ? wx : (1.0f - wx)) *
+                          (((k >> 1) != 0) ? wy : (1.0f - wy));
+        acc += wgt * float(data_a[(uint(cy) * p.W + uint(cx)) * p.C + c]);
+    }
+    data_d[i] = D_TYPE(acc);
+}
diff --git a/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp b/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp
new file mode 100644
index 00000000..acc40568
--- /dev/null
+++ b/src/ggml-vulkan/vulkan-shaders/im2col_cf.comp
@@ -0,0 +1,53 @@
+#version 450
+// channels-first im2col: src [IC, IW, IH, 1] contiguous, dst rows are
+// ic-fastest: r = ic + IC*(kw + KW*kh). One workgroup slice per output
+// pixel (y = ow, z = oh), x-threads loop over R = IC*KW*KH.
+//   binding 0: src  [IC, IW, IH] f32 (the op's src1)
+//   binding 1: dst  [R, OW, OH]  (D_TYPE f32/f16)
+
+#include "types.glsl"
+
+layout (push_constant) uniform parameter
+{
+    uint IC;
+    uint IW;
+    uint IH;
+    uint OW;
+    uint OH;
+    uint KW;
+    uint R;   // IC*KW*KH
+    int  s0;
+    int  s1;
+    int  p0;
+    int  p1;
+    int  d0;
+    int  d1;
+} p;
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
+layout (binding = 1) writeonly buffer D {D_TYPE data_d[];};
+
+void main() {
+    const uint ow = gl_GlobalInvocationID.y;
+    const uint oh = gl_GlobalInvocationID.z;
+    if (ow >= p.OW || oh >= p.OH) {
+        return;
+    }
+    const uint base = (oh * p.OW + ow) * p.R;
+    const uint stride = gl_WorkGroupSize.x * gl_NumWorkGroups.x;
+    for (uint r = gl_GlobalInvocationID.x; r < p.R; r += stride) {
+        const uint ic = r % p.IC;
+        const uint k  = r / p.IC;
+        const uint kw = k % p.KW;
+        const uint kh = k / p.KW;
+        const int iw = int(ow) * p.s0 + int(kw) * p.d0 - p.p0;
+        const int ih = int(oh) * p.s1 + int(kh) * p.d1 - p.p1;
+        float v = 0.0f;
+        if (iw >= 0 && iw < int(p.IW) && ih >= 0 && ih < int(p.IH)) {
+            v = float(data_a[(uint(ih) * p.IW + uint(iw)) * p.IC + ic]);
+        }
+        data_d[base + r] = D_TYPE(v);
+    }
+}

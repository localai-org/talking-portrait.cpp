+// channels-first im2col (src [IC, IW, IH, 1]); rows ic-fastest:
+// r = ic + IC*(kw + KW*kh). One block per output pixel, int32 indexing,
+// pow2-IC fast path.
+template <typename T, bool IC_POW2>
+static __global__ void im2col_cf_kernel(
+        const float * __restrict__ x, T * __restrict__ dst,
+        const int IC, const int ic_shift, const int IW, const int IH,
+        const int OW, const int R,
+        const int s0, const int s1, const int p0, const int p1,
+        const int d0, const int d1, const int KW) {
+    const int n  = blockIdx.x;
+    const int ow = n % OW;
+    const int oh = n / OW;
+    const int64_t base = (int64_t) n * R;
+    for (int r = threadIdx.x; r < R; r += blockDim.x) {
+        int ic, k;
+        if (IC_POW2) {
+            ic = r & (IC - 1);
+            k  = r >> ic_shift;
+        } else {
+            ic = r % IC;
+            k  = r / IC;
+        }
+        const int kw = k % KW;
+        const int kh = k / KW;
+        const int iw = ow * s0 + kw * d0 - p0;
+        const int ih = oh * s1 + kh * d1 - p1;
+        float v = 0.0f;
+        if (iw >= 0 && iw < IW && ih >= 0 && ih < IH) {
+            v = x[(int64_t) (ih * IW + iw) * IC + ic];
+        }
+        dst[base + r] = v;
+    }
+}

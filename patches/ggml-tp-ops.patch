+// ggml_compute_forward_bilinear_gather
+// torch grid_sample (bilinear, zeros padding, align_corners=false) over a
+// channels-first flattened map: src0 [C, W*H] (F32/F16), src1 [2, N] grid,
+// dst [C, N] F32.
+
+void ggml_compute_forward_bilinear_gather(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+    const ggml_tensor * src1 = dst->src[1];
+
+    const int32_t W = ((const int32_t *)(dst->op_params))[0];
+    const int32_t H = ((const int32_t *)(dst->op_params))[1];
+
+    const int64_t C = src0->ne[0];
+    const int64_t N = src1->ne[1];
+
+    const float * grid = (const float *) src1->data;
+    float * out = (float *) dst->data;
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    for (int64_t n = ith; n < N; n += nth) {
+        const float gx = grid[2*n + 0];
+        const float gy = grid[2*n + 1];
+        const float fx = (gx + 1.0f) * 0.5f * (float) W - 0.5f;
+        const float fy = (gy + 1.0f) * 0.5f * (float) H - 0.5f;
+        const int64_t x0 = (int64_t) floorf(fx);
+        const int64_t y0 = (int64_t) floorf(fy);
+        const float wx = fx - (float) x0;
+        const float wy = fy - (float) y0;
+
+        float * d = out + C*n;
+        for (int64_t c = 0; c < C; c++) d[c] = 0.0f;
+
+        for (int k = 0; k < 4; k++) {
+            const int64_t cx = x0 + (k & 1);
+            const int64_t cy = y0 + (k >> 1);
+            if (cx < 0 || cx >= W || cy < 0 || cy >= H) continue;
+            const float wgt = ((k & 1) ? wx : 1.0f - wx) * ((k >> 1) ? wy : 1.0f - wy);
+            const int64_t row = cy * W + cx;
+            if (src0->type == GGML_TYPE_F16) {
+                const ggml_fp16_t * f = (const ggml_fp16_t *) src0->data + C*row;
+                for (int64_t c = 0; c < C; c++) d[c] += wgt * GGML_CPU_FP16_TO_FP32(f[c]);
+            } else {
+                const float * f = (const float *) src0->data + C*row;
+                for (int64_t c = 0; c < C; c++) d[c] += wgt * f[c];
+            }
+        }
+    }
+}
